#!/bin/sh
# Commit message rules. Enable once per clone with:
#   git config core.hooksPath .githooks
msg_file="$1"

# 1) No tool attribution.
if grep -iE 'co-authored-by|noreply@anthropic\.com|generated with .*claude|claude\.com/claude-code' "$msg_file" >/dev/null; then
  echo "----------------------------------------------------------------" >&2
  echo "✖ Commit reddedildi: mesajda Co-authored-by / Claude atfı var." >&2
  echo "  İlgili satırları kaldırıp tekrar commit'le." >&2
  echo "----------------------------------------------------------------" >&2
  exit 1
fi

# 2) Subject line must be plain ASCII. Messages are written in English, and a
#    Turkish subject is how that rule slips in practice — a PR title becomes
#    the squash commit's subject.
subject=$(head -1 "$msg_file")
if [ -n "$(printf '%s' "$subject" | LC_ALL=C tr -d '\000-\177')" ]; then
  echo "----------------------------------------------------------------" >&2
  echo "✖ Commit reddedildi: konu satırı ASCII olmalı (İngilizce yazın)." >&2
  echo "  Konu: $subject" >&2
  echo "----------------------------------------------------------------" >&2
  exit 1
fi

exit 0
